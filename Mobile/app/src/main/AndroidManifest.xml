<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Único permiso necesario: APIs públicas (Groq, Pexels, Hugging Face, lectores de noticias).
         Foto/vídeo se eligen con ACTION_GET_CONTENT y el guardado usa SAF o MediaStore (Android 10+),
         así que no hacen falta CAMERA, RECORD_AUDIO, READ_MEDIA_* ni WRITE_EXTERNAL_STORAGE. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="Pulse Studio" android:icon="@drawable/ic_pulse"
        android:theme="@style/AppTheme" android:allowBackup="false"
        android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false" android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true" android:hardwareAccelerated="true" android:largeHeap="true">
        <activity android:name=".MainActivity" android:exported="true" android:hardwareAccelerated="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
